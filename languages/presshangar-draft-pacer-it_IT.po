#. Plugin URI of the plugin
#: presshangar-draft-pacer.php
msgid "https://presshangar.com/presshangar-draft-pacer"
msgstr ""

#. Description of the plugin
#: presshangar-draft-pacer.php
msgid ""
"Source-agnostic natural pacing publishing layer for WordPress drafts, by "
"PressHangar (a brand of Musubiemu LLC). Schedules drafts as \"future\" posts"
" with human-like intervals and guarantees zero missed publications via a "
"self-healing watchdog. Does not generate any content."
msgstr ""
"Livello di pubblicazione a ritmo naturale, indipendente dalla fonte, per le "
"bozze di WordPress, di PressHangar (un marchio di Musubiemu LLC). Programma "
"le bozze come articoli «futuri» a intervalli realistici e garantisce zero "
"pubblicazioni mancate grazie a un watchdog auto-riparante. Non genera alcun "
"contenuto."

#. Author of the plugin
#: presshangar-draft-pacer.php
msgid "Musubiemu LLC"
msgstr ""

#. Author URI of the plugin
#: presshangar-draft-pacer.php
msgid "https://presshangar.com"
msgstr ""

